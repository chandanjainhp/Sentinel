# =============================================================================
# client/.env.example  →  copy to client/.env
# Only env file the Next.js UI needs (local `npm run dev`).
# Pi compose sets API_UPSTREAM_URL itself — no client .env required on the Pi.
# =============================================================================

# SSR / rewrite fallback to the API on the host (browser still uses same-origin /api/v1)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# NEXT_PUBLIC_SUPPORT_EMAIL=support@sentinel.io

# --- Google Sign-In (Google Identity Services) ---
# Public OAuth Client ID — same value as GOOGLE_CLIENT_ID in server/.env.
# NEXT_PUBLIC_* is inlined into the browser bundle by design (it is public).
# No client secret ever goes here. See README → Google Login Setup.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
